# Dépendances
node_modules

# Artefacts de build et caches
dist
dist-ssr
coverage
*.tsbuildinfo
.vite
.vite-temp

# Variables d'environnement et secrets (aucune valeur ne doit être versionnée)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.local

# Cloudflare / Wrangler : état local, caches et fichiers temporaires
.wrangler/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Éditeurs et OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
