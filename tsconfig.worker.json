{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],

    /* Types du runtime Workers, générés depuis wrangler.jsonc par
       `pnpm generate:types`. Aucun paquet @types n'est inclus implicitement :
       le Worker ne doit voir ni les types DOM du front ni ceux de Node. */
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode : le Worker est empaqueté par Wrangler/Vite */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["worker-configuration.d.ts", "worker/src"]
}
