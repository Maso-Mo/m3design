{
  // ---------------------------------------------------------------------------
  // M3Design — configuration du Worker Cloudflare (API + front statique)
  // ---------------------------------------------------------------------------
  // Ce fichier est VERSIONNÉ : il ne doit contenir aucun identifiant de compte,
  // aucun identifiant de base de données ni aucun secret. En local, les secrets
  // vont dans .dev.vars (ignoré par Git, modèle : .dev.vars.example) ; en ligne,
  // ils sont posés avec `wrangler secret put <NOM>`.
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Nom du Worker : c'est aussi le nom de l'environnement Vite créé par le
  // plugin Cloudflare pour Vite.
  "name": "m3design",

  // Point d'entrée de l'API (Hono).
  "main": "./worker/src/index.ts",

  // Date de compatibilité du runtime. À figer : ne la faire évoluer qu'après
  // lecture des notes de version, car certains comportements changent.
  "compatibility_date": "2026-09-21",

  "assets": {
    // Le front est une page unique : toute URL inconnue renvoie index.html, le
    // routage (/devis/confirmation, /admin/*) étant assuré côté client.
    // Le build (vite build) renseigne assets.directory automatiquement.
    "not_found_handling": "single-page-application",

    // Le Worker est invoqué AVANT les assets statiques sur /api/* : une route
    // d'API inexistante reçoit donc toujours une réponse JSON, jamais index.html.
    "run_worker_first": ["/api/*"],

    // Permet au Worker de servir lui-même les assets (repli hors API).
    "binding": "ASSETS",
  },

  // Journaux et traces du Worker dans le tableau de bord Cloudflare.
  "observability": { "enabled": true },

  // ---------------------------------------------------------------------------
  // Traitement périodique de la file des notifications (email_outbox)
  // ---------------------------------------------------------------------------
  // Toutes les cinq minutes, le Worker est invoqué sur son handler `scheduled`
  // (worker/src/scheduled.ts) : il envoie les notifications en attente, réessaie
  // celles qui ont échoué, abandonne celles qui dépassent le plafond de tentatives
  // et purge les notifications acceptées depuis plus de trente jours.
  //
  // Exception volontaire : le lien magique Contact, valable cinq minutes, est
  // envoyé immédiatement par la route HTTP. Les notifications finales destinées
  // à M3Design restent exclusivement traitées ici via l'outbox.
  //
  // Si l'envoi n'est pas configuré (EMAIL_PROVIDER, adresse d'expédition, clé ou
  // binding absent), le passage est ANNULÉ avant toute écriture : les notifications
  // restent en attente, et une ligne de journal indique le motif. Une file qui
  // attend une configuration n'est donc jamais perdue.
  //
  // Cinq minutes est un compromis : assez fréquent pour qu'une demande soit
  // signalée dans la minute qui suit, assez rare pour ne pas multiplier les
  // invocations inutiles. La fréquence se change ici, sans toucher au code.
  "triggers": { "crons": ["*/5 * * * *"] },

  // ---------------------------------------------------------------------------
  // Base de données D1 (SQLite hébergé par Cloudflare)
  // ---------------------------------------------------------------------------
  // Le binding s'appelle DB : c'est le nom utilisé dans le code (c.env.DB).
  //
  // Trois bases distinctes, une par environnement : développement (ci-dessous,
  // utilisée par `pnpm dev`), prévisualisation et production (sections env). Un
  // test ou une erreur de prévisualisation ne peut donc jamais atteindre les
  // données de production.
  //
  // Les identifiants de base sont propres au compte Cloudflare : ils ne sont pas
  // versionnés. Les valeurs ci-dessous sont des marqueurs à remplacer après
  // `wrangler d1 create <nom>` (voir README, section Backend et déploiement).
  // En local, wrangler crée sa propre base SQLite dans .wrangler/ (ignoré par
  // Git) : aucune base distante n'est créée ni contactée par `pnpm dev`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "m3design-development",
      "database_id": "REMPLACER_ID_BASE_DEVELOPPEMENT",
      "migrations_dir": "worker/migrations",
    },
  ],

  // Environnements de déploiement : chacun devient un Worker distinct
  // (m3design-preview, m3design-production) avec sa propre base de données.
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "m3design-preview",
          "database_id": "REMPLACER_ID_BASE_PREVIEW",
          "migrations_dir": "worker/migrations",
        },
      ],
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "m3design-prod",
          "database_id": "ce4dda81-3479-4ddf-ad91-dc1625d18488",
          "migrations_dir": "worker/migrations",
        },
      ],
    },
  },
}
